{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.5.0",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/injected/bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "css": [
        "src/styles.css"
      ],
      "js": [
        "src/content/constants.js",
        "src/content/bridge-client.js",
        "src/content/i18n.js",
        "src/vendor/o200k_base.js",
        "src/content/tokens.js",
        "src/content/usage.js",
        "src/content/ui.js",
        "src/content/main.js"
      ]
    }
  ],
  "default_locale": "en",
  "version_name": "0.5.0-beta.3",
  "minimum_chrome_version": "111"
}
